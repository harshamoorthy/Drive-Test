<!DOCTYPE html>
<html lang="en">
    <!-- ======= Header ======= -->
    <%- include('layouts/header'); -%>
    <body>
        <!-- ======= Navbar ======= -->
        <%- include('layouts/navbar'); -%>
        <!-- ======= Hero Section ======= -->
        <section id="hero">
            <div id="heroCarousel" data-bs-interval="5000" class="carousel slide carousel-fade" data-bs-ride="carousel">

                <ol class="carousel-indicators" id="hero-carousel-indicators"></ol>

                <div class="carousel-inner" role="listbox">

                    <!-- Slide 1 -->
                    <div class="carousel-item active" style="background-image: url(assets/img/hero1test.jpg)">
                        <div class="carousel-container">
                            <div class="container">
                                <h2 class="animate__animated animate__fadeInDown">DASHBOARD</h2>
                                <p class="animate__animated animate__fadeInUp">DriveTest Booking Kiosk</p>
                                <a href="#about" class="btn-get-started animate__animated animate__fadeInUp scrollto">Read More</a>
                            </div>
                        </div>
                    </div>

                    <!-- Slide 2 -->
                    <div class="carousel-item" style="background-image: url(assets/img/hero2test.jpg)">
                        <div class="carousel-container">
                            <div class="container">
                                <h2 class="animate__animated animate__fadeInDown">Book Ontario Drive Test</h2>
                                <p class="animate__animated animate__fadeInUp">Book G G2 M M2 Road Test 64 Drive Test  Locations.</p>
                                <a href="#about" class="btn-get-started animate__animated animate__fadeInUp scrollto">Read More</a>
                            </div>
                        </div>
                    </div>
                </div>

                <a class="carousel-control-prev" href="#heroCarousel" role="button" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon bi bi-chevron-left" aria-hidden="true"></span>
                </a>

                <a class="carousel-control-next" href="#heroCarousel" role="button" data-bs-slide="next">
                    <span class="carousel-control-next-icon bi bi-chevron-right" aria-hidden="true"></span>
                </a>

            </div>
        </section><!-- End Hero -->

        <main id="main">
            <!-- ======= About Us Section ======= -->
            <section id="about" class="about">
                <div class="container">

                    <div class="section-title">
                        <h2>Welcome To The Drive Test Ontario</h2>

                    </div>
                    <div class="row">
                        <div class="col-lg-6 order-1 order-lg-2">
                            <img src="assets/img/drive-test-ontario3.png" class="img-fluid" alt="">
                        </div>
                        <div class="col-lg-6 pt-4 pt-lg-0 order-2 order-lg-1 content">

                            <p class="fst-italic">
                                Drive Test Ontario is best booking service 100% customer satisfaction. All 64 road test centers are completely booked for months in advance if you need your license sooner date and close location, our team search test slots 24/7 and book earlier dates. <br><br>Booking service for G test booking, G2 road test, M2 motorcycle or M motorcycle road test booking. We use secure online system to protect our customers. Book G or G2 road test in Ontario with confidence you will get closer date and location as you ordered. <br><br>There are millions of licensed drivers in Ontario. Most of these drivers started by visiting a DriveTest Centre and applying for a Class G licence. A Class G licence enables you to drive a car, van, or small truck.
                            </p>
                        </div>
                    </div>
                </div>
            </section><!-- End About Us Section -->
            <!-- ======= Featured Services Section ======= -->
            <section id="featured-services" class="featured-services section-bg">
                <div class="container">
                    <div class="row no-gutters">
                        <div class="col-lg-4 col-md-6">
                            <div class="icon-box">
                                <div class="icon"><i class="bi bi-car-front"></i></div>
                                <h4 class="title"><a href="">Cars</a></h4>
                                <p class="description">Driver examination and licensing requirements for cars, vans, and small trucks.</p>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="icon-box">
                                <div class="icon"><i class="bi bi-bicycle"></i></div>
                                <h4 class="title"><a href="">Motorcycles</a></h4>
                                <p class="description">Driver examination and licensing requirements for motorcycles, scoorters, and mopeds.</p>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="icon-box">
                                <div class="icon"><i class="bi bi-truck"></i></div>
                                <h4 class="title"><a href="">Commercial</a></h4>
                                <p class="description">Driver examination and licensing requirements for classes A, B, C, D,E, F or Z- trucks and buses.</p>
                            </div>
                        </div>
                    </div>

                </div>
            </section><!-- End Featured Services Section -->
            <!-- ======= Cta Section ======= -->
            <section id="cta" class="cta">
                <div class="container">

                    <div class="row">
                        <div class="col-lg-9 text-center text-lg-start">
                            <h3>You can book G2/G drive test from this kiosk</h3>
                            <p> All driver-related tests take place at DriveTest Centres across the province. Appointments are usually required for road tests.<br> <br>
                                All tests are available in English or French. Test results are available immediately. Applicants can take the knowledge and road tests as many times as they need to pass.</p>
                        </div>
                        <div class="col-lg-3 cta-btn-container text-center">
                            <a class="cta-btn align-middle" href="#">Book a Test</a>
                        </div>
                    </div>

                </div>
            </section><!-- End Cta Section -->
        </main><!-- End #main -->
        <!-- ======= Footer ======= -->
        <%- include('layouts/footer'); -%>
        <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>
        <!-- Vendor JS Files -->
        <%- include('layouts/scripts'); -%>
    </body>

</html>
