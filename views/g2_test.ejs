<!DOCTYPE html>
<html lang="en">
<!-- ======= header ======= -->
<%- include('layouts/header'); -%>

    <body>
        <!-- ======= Navbar ======= -->
        <%- include('layouts/navbar'); -%>

            <main id="main">
                <!-- ======= Cta Section ======= -->
                <section id="cta" class="cta">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-9 text-center text-lg-start">
                                <h3>G2 TEST</h3>
                                <p>
                                    Level 2 of Graduated Licence for a Car, Van or Small Truck. This
                                    test assesses basic driving skills, is commonly city driving
                                    skills referred to as a “Eligibility one year G1 driver
                                    experience or 1 year foreign experience, successful will get G2
                                </p>
                            </div>
                            <div class="col-lg-3 cta-btn-container text-center">
                                <a class="cta-btn align-middle" href="#">Book Now</a>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- End Cta Section -->

                <!-- ======= Contact Section ======= -->
                <section id="contact" class="contact">
                    <% if (license_number==='default' ) { %>

                        <div class="container">
                            <div class="section-title">
                                <h2>Your are close to book your drive test</h2>
                                <p>
                                    Please make sure you choose right class of road test class G, G2.
                                    You will receive confirmation an email once you book your order
                                    and we will start search slot for you.
                                </p>
                            </div>

                            <div class="row">
                                <div class="col-lg-12 mt-10 mt-lg-0 d-flex align-items-stretch">
                                    <form id="userForm" action="/users/store" method="POST" role="form" class="g2_form">
                                        <div class="row">
                                            <div class="form-group col-md-6">
                                                <label for="firstname">First Name</label>
                                                <input type="text" name="firstname" class="form-control" id="firstname"
                                                    required />
                                            </div>
                                            <div class="form-group col-md-6 mt-3 mt-md-0">
                                                <label for="lastname">Last Name</label>
                                                <input type="text" class="form-control" name="lastname" id="lastname"
                                                    required />
                                            </div>
                                        </div><br />

                                        <div class="row">
                                            <div class="form-group col-md-6 mt-3 mt-md-0">
                                                <label for="license_number">License Number</label>
                                                <input type="text" class="form-control" name="license_number"
                                                    id="license_number" maxlength="8"
                                                    placeholder="Enter min 8 characters" required />
                                            </div>
                                            <div class="form-group col-md-6">
                                                <label for="age">Age</label>
                                                <input type="number" name="age" class="form-control" id="age"
                                                    required />
                                            </div>
                                        </div>
                                        <br />
                                        <div class="row">
                                            <b>
                                                <p>CAR DETAILS:</p>
                                            </b>
                                        </div>

                                        <div class="row">
                                            <div class="form-group col-md-6">
                                                <label for="make">Make</label>
                                                <input type="text" name="make" class="form-control" id="make"
                                                    required />
                                            </div>
                                            <div class="form-group col-md-6 mt-3 mt-md-0">
                                                <label for="model">Model</label>
                                                <input type="text" class="form-control" name="model" id="model"
                                                    required />
                                            </div>
                                        </div>
                                        <br />

                                        <div class="row">
                                            <div class="form-group col-md-6">
                                                <label for="year">Year</label>
                                                <input type="number" name="year" class="form-control" id="year"
                                                    required />
                                            </div>
                                            <div class="form-group col-md-6 mt-3 mt-md-0">
                                                <label for="plate">Plate Number</label>
                                                <input type="text" class="form-control" name="plate" id="plate"
                                                    required />
                                            </div>
                                        </div>
                                        <br />

                                        <div class="text-center">
                                            <button type="submit">Book</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <% } else { %>
                            <div class="container">
                                <div class="section-title">
                                    <h2>You have already booked your drive test.</h2>
                                    <p>
                                        Thank you for choosing us.
                                    </p>
                                </div>
                            </div>
                            <% } %>
                </section>
                <!-- End Contact Section -->
            </main>
            <!-- End #main -->
            <!-- ======= Footer ======= -->
            <%- include('layouts/footer'); -%>
                <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i
                        class="bi bi-arrow-up-short"></i></a>
                <!-- Vendor JS Files -->
                <%- include('layouts/scripts'); -%>
    </body>

</html>