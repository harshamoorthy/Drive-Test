<html>
      <!-- ======= Top Bar ======= -->
  <section id="topbar" class="d-flex align-items-center">
    <div class="container d-flex justify-content-center justify-content-md-between">
      <div class="contact-info d-flex align-items-center">
        <i class="bi bi-envelope-fill"></i><a href="mailto:contact@example.com">info@drivetest.com</a>
        <i class="bi bi-phone-fill phone-icon"></i> +1 556-787-7899
      </div>
      <div class="social-links d-none d-md-block">
        <a href="#" class="twitter"><i class="bi bi-twitter"></i></a>
        <a href="#" class="facebook"><i class="bi bi-facebook"></i></a>
        <a href="#" class="instagram"><i class="bi bi-instagram"></i></a>
        <a href="#" class="linkedin"><i class="bi bi-linkedin"></i></i></a>
      </div>
    </div>
  </section>

     <!-- ======= Header ======= -->
  <header id="header" class="d-flex align-items-center">
    <div class="container d-flex align-items-center">

      <h1 class="logo me-auto"><a href="/">Book Drive Test</a></h1>

      <nav id="navbar" class="navbar">
        <ul>
          <li><a class="nav-link scrollto active" href="/">Dashboard</a></li>
          <% if (loggedIn && userType === 'Driver') { %>
          <li><a class="nav-link scrollto active" href="/g2_test">G2_Test</a></li>
          <li><a class="nav-link scrollto active" href="/g_test">G_Test</a></li>
          <% } %>
          <% if (loggedIn) { %>
          <li><a class="nav-link scrollto active" href="/auth/logout">Logout</a></li>
          <% } %>
          <% if(!loggedIn) { %>
          <li><a class="nav-link scrollto active" href="/signup">Signup</a></li>
          <li><a class="getstarted scrollto" href="/login">Login</a></li>
          <% } %>
        </ul>
        <i class="bi bi-list mobile-nav-toggle"></i>
      </nav><!-- .navbar -->

    </div>
  </header><!-- End Header -->
</html>